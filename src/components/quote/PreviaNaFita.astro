---
// A pessoa anexa a logo da empresa e vê a fita impressa lacrando uma caixa. Mora na página da fita
// personalizável (não na home): é ferramenta de quem já está decidindo o produto. A imagem nunca sai
// do navegador (URL.createObjectURL); o arquivo vai pelo WhatsApp, que o link não consegue anexar.
import WhatsAppCta from "./WhatsAppCta.astro";
import { PRODUTOS, type Produto } from "../../lib/produtos";

interface Props {
  produto: Produto;
}
const { produto } = Astro.props;

const brl = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
const spec = (p: Produto, label: string) => p.specs.find((s) => s.label === label)?.valor ?? "";

// Largura real da fita: a altura da faixa na caixa segue a proporção 48 mm × 70 mm.
const opcoes = PRODUTOS.filter((p) => p.personalizavel).map((p) => ({
  slug: p.slug,
  rotulo: `${p.slug === "fita-gomada" ? "Kraft gomada" : "Transparente"} · ${spec(p, "Largura")}`,
  material: p.slug === "fita-gomada" ? "kraft" : "bopp",
  larguraMm: parseInt(spec(p, "Largura"), 10),
  minimo: parseInt(spec(p, "Pedido mínimo"), 10),
  preco: brl(p.preco.aPartirDe),
  condicao: p.preco.condicao ?? "",
  contexto: p.contexto,
  origem: `Prévia · ${p.nome}`,
  nome: p.nome,
}));
const atual = opcoes.find((o) => o.slug === produto.slug) ?? opcoes[0];

const LOGO_PADRAO = "Sua logo aqui";
const TIPOS_ACEITOS = "image/png,image/jpeg,image/webp,image/svg+xml";
// Acima disso é foto, não logo: o arquivo pesaria na memória do celular sem ganho na prévia.
const LOGO_MAX_MB = 10;
const AVISO = "Esta fita é sua garantia";
const REPETICOES = 4;
---

<section
  data-art="sua-marca"
  data-opcoes={JSON.stringify(opcoes)}
  data-logo-max-mb={LOGO_MAX_MB}
  class="grao-kraft bg-kraft-100"
  aria-labelledby="previa-titulo"
>
  <div class="previa mx-auto max-w-6xl px-4 py-16 md:py-20">
    <header class="previa__cabeca">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-orange-800">Teste antes de pedir</p>
      <h2 id="previa-titulo" class="mt-3 text-3xl text-navy md:text-[2.75rem]">Anexe a logo da sua empresa e veja a fita.</h2>
    </header>

    <div class="previa__palco">
      <figure class="caixa" style={`--sm-largura-mm: ${atual.larguraMm}`} role="img" aria-label={`Prévia: ${atual.rotulo} lacrando uma caixa de papelão, ainda sem logo`} data-caixa>
        <div class="aba aba--cima"></div>
        <div class="aba aba--baixo"></div>
        <div class="fibra grao-kraft"></div>
        <div class="canal"></div>
        <div class="faixa fita" data-fita data-material={atual.material}></div>
        <div class="faixa fita__impressao" data-impressao>
            {
              Array.from({ length: REPETICOES }, () => (
                <>
                  <span class="fita__marca">
                    <span class="fita__nome" data-nome>{LOGO_PADRAO}</span>
                    <img class="fita__logo" alt="" hidden data-logo />
                  </span>
                  <span class="fita__aviso">{AVISO}</span>
                </>
              ))
            }
        </div>
        <div class="borda"></div>
      </figure>
      <p class="mt-3 font-mono md:text-right text-[0.68rem] uppercase tracking-[0.12em] text-steel">
        Prévia ilustrativa · a logo fica só no seu navegador · a arte final sai em até 2 cores
      </p>
    </div>

    <form class="previa__controles" data-controles onsubmit="return false">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-steel" id="previa-logo-rotulo">Logo na fita</p>
      <label class="anexo mt-2">
        <input
          type="file"
          name="logo"
          accept={TIPOS_ACEITOS}
          class="sr-only"
          aria-describedby="previa-logo-ajuda"
          data-arquivo
        />
        <span class="anexo__botao" aria-hidden="true">Anexar logo</span>
        <span class="anexo__nome" data-arquivo-nome>PNG, JPG, WebP ou SVG</span>
      </label>
      <p id="previa-logo-ajuda" class="mt-2 font-body text-xs text-steel" data-ajuda aria-live="polite">
        Fundo branco ou transparente fica melhor. Até {LOGO_MAX_MB} MB.
      </p>

      <fieldset class="mt-6">
        <legend class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-steel">Fita</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            opcoes.map((o) => (
              <label class="opcao">
                <input type="radio" name="fita" value={o.slug} checked={o.slug === atual.slug} class="sr-only" data-opcao />
                <span>{o.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
        <div>
          <dt class="sr-only">Pedido mínimo</dt>
          <dd class="font-display text-[1.75rem] font-extrabold leading-none tabular-nums text-navy" data-minimo>{atual.minimo}</dd>
          <dd class="mt-1 font-body text-sm text-steel">rolos no mínimo</dd>
        </div>
        <div>
          <dt class="sr-only">Preço por rolo</dt>
          <dd class="font-display text-[1.75rem] font-extrabold leading-none tabular-nums text-navy" data-preco>{atual.preco}</dd>
          <dd class="mt-1 font-body text-sm text-steel">a partir de, por rolo <span class="block text-xs" data-condicao>{atual.condicao}</span></dd>
        </div>
      </dl>

      <div class="mt-6" data-cta>
        <WhatsAppCta label="Pedir orçamento com esta logo" contexto={atual.contexto} paginaOrigem={atual.origem} />
      </div>
    </form>
  </div>
</section>

<style>
  /* art-direction · sua-marca-na-fita · eixos: pigmento/estado/média · orçamento: 2kb · 2026-10-17 */
  [data-art="sua-marca"] {
    --sm-caixa-luz: oklch(0.755 0.084 75);
    --sm-caixa: oklch(0.698 0.087 71.4);
    --sm-caixa-dobra: oklch(0.625 0.085 71.3);
    --sm-caixa-sombra: oklch(0.55 0.075 71.5);
    --sm-caixa-baixo: oklch(0.707 0.085 71.7);
    --sm-caixa-borda: oklch(0.383 0.065 67.8);
    --sm-gomada: oklch(0.806 0.072 79.1);
    --sm-gomada-fio: oklch(0.69 0.083 77.6);
    /* O BOPP é luz sobre o papelão: branco morno com alfa, nunca croma 0. */
    --sm-bopp-brilho: oklch(0.99 0.006 85 / 0.34);
    --sm-bopp-meio: oklch(0.99 0.006 85 / 0.12);
    --sm-bopp-fundo: oklch(0.99 0.006 85 / 0.22);
    --sm-bopp-reflexo: oklch(0.99 0.006 85 / 0.4);
    --sm-bopp-borda: oklch(0.99 0.006 85 / 0.35);
    --sm-bopp-opaco: oklch(0.8 0.06 76);
    --sm-canal: oklch(0.99 0.006 85 / 0.035);
    --sm-campo: oklch(0.995 0.004 85);
    /* Duas tintas, como a impressão real: o nome em navy, o aviso em laranja queimado (4,5:1 nas duas fitas). */
    --sm-tinta-nome: var(--color-navy);
    --sm-tinta-aviso: oklch(0.4 0.13 45);
    --sm-sombra-caixa: 0 40px 60px -30px color-mix(in oklch, var(--color-breu) 60%, transparent),
      0 8px 18px -8px color-mix(in oklch, var(--sm-caixa-borda) 55%, transparent);
    --sm-sombra-campo: 0 10px 24px -14px color-mix(in oklch, var(--color-navy) 45%, transparent);
    --sm-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --sm-dur-impressao: 700ms;
    --sm-dur-troca: 220ms;
    /* 48 mm de fita = 23% da altura da tampa; a gomada (70 mm) cresce na mesma proporção. */
    --sm-faixa-por-mm: 0.48%;
  }

  /* Celular: título → prévia → controles. Desktop: título e controles à esquerda, a caixa à direita. */
  .previa {
    display: grid;
    gap: 2rem;
    grid-template-areas: "cabeca" "palco" "controles";
  }
  .previa__cabeca { grid-area: cabeca; }
  .previa__palco { grid-area: palco; }
  .previa__controles { grid-area: controles; }
  @media (min-width: 900px) {
    .previa {
      grid-template-columns: 4fr 8fr;
      grid-template-areas: "cabeca palco" "controles palco";
      column-gap: 3rem;
      row-gap: 0;
      align-items: center;
    }
    .previa__cabeca { align-self: end; }
    .previa__controles { align-self: start; margin-top: 1.75rem; }
  }

  /* O campo de arquivo é um rótulo inteiro clicável: botão navy + o nome do arquivo escolhido. */
  .anexo {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    cursor: pointer;
    background: var(--sm-campo);
    border: 2px solid var(--color-navy);
    border-radius: 10px;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    box-shadow: var(--sm-sombra-campo);
  }
  .anexo:has(input:focus-visible) { outline: 2px solid var(--color-ink); outline-offset: 2px; box-shadow: 0 0 0 4px var(--color-orange); }
  .anexo__botao {
    flex: none;
    font: 600 1rem var(--font-body);
    color: var(--sm-campo);
    background: var(--color-navy);
    border-radius: 7px;
    padding: 0.7rem 1rem;
  }
  .anexo__nome {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 500 0.95rem var(--font-body);
    color: var(--color-steel);
  }
  .anexo[data-com-logo] .anexo__nome { color: var(--color-navy); font-weight: 600; }

  .opcao span {
    display: inline-block;
    cursor: pointer;
    font: 600 0.875rem var(--font-body);
    color: var(--color-navy);
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid color-mix(in oklch, var(--color-navy) 40%, transparent);
    transition: background-color var(--sm-dur-troca) var(--sm-ease), color var(--sm-dur-troca) var(--sm-ease);
  }
  .opcao input:checked + span { background: var(--color-navy); color: var(--sm-campo); border-color: var(--color-navy); }
  .opcao input:focus-visible + span { outline: 2px solid var(--color-ink); outline-offset: 2px; box-shadow: 0 0 0 2px var(--color-orange); }

  /* A tampa: duas abas de papelão, a de cima na luz, a de baixo na sombra da emenda. */
  .caixa {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--sm-caixa);
    box-shadow: var(--sm-sombra-caixa);
  }
  .aba { position: absolute; left: 0; right: 0; height: 50%; }
  .aba--cima { top: 0; background: linear-gradient(180deg, var(--sm-caixa-luz), var(--sm-caixa) 85%, var(--sm-caixa-dobra)); }
  .aba--baixo { bottom: 0; background: linear-gradient(180deg, var(--sm-caixa-sombra), var(--sm-caixa-dobra) 14%, var(--sm-caixa-baixo)); }
  .fibra { position: absolute; inset: 0; mix-blend-mode: multiply; opacity: 0.55; background-size: 160px; }
  .canal { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--sm-canal) 0 3px, transparent 3px 9px); }
  .borda {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    box-shadow: inset 0 0 0 10px color-mix(in oklch, var(--sm-caixa-borda) 18%, transparent),
      inset 0 0 50px color-mix(in oklch, var(--sm-caixa-borda) 40%, transparent);
  }

  /* A película e a impressão são camadas irmãs com a mesma geometria: a impressão precisa
     enxergar o papelão por baixo para o multiply funcionar (dentro da película girada, ela só
     enxergaria a própria película e o fundo branco da logo ficaria). */
  .faixa {
    position: absolute;
    left: -2%;
    right: -2%;
    top: 50%;
    height: calc(var(--sm-largura-mm) * var(--sm-faixa-por-mm));
    translate: 0 -50%;
    rotate: -1.2deg;
    transition: height var(--sm-dur-troca) var(--sm-ease);
  }
  .fita { transition: height var(--sm-dur-troca) var(--sm-ease), background var(--sm-dur-troca) var(--sm-ease); }
  .fita[data-material="bopp"] {
    background: linear-gradient(180deg, var(--sm-bopp-brilho), var(--sm-bopp-meio) 40%, var(--sm-bopp-fundo));
    border-block: 1px solid var(--sm-bopp-borda);
    box-shadow: inset 0 1px 0 var(--sm-bopp-reflexo);
  }
  /* Gomada reforçada: papel kraft opaco com os fios de nylon cruzados na trama. */
  .fita[data-material="kraft"] {
    background:
      repeating-linear-gradient(60deg, color-mix(in oklch, var(--sm-gomada-fio) 55%, transparent) 0 1px, transparent 1px 14px),
      repeating-linear-gradient(-60deg, color-mix(in oklch, var(--sm-gomada-fio) 55%, transparent) 0 1px, transparent 1px 14px),
      var(--sm-gomada);
    box-shadow: 0 2px 4px color-mix(in oklch, var(--sm-caixa-borda) 35%, transparent);
  }

  /* multiply: o fundo branco de uma logo em JPG some na fita, como a tinta que só existe onde imprime. */
  .fita__impressao {
    display: flex;
    align-items: center;
    gap: 2.6rem;
    padding-left: 1.5rem;
    overflow: hidden;
    white-space: nowrap;
    mix-blend-mode: multiply;
  }
  .fita__marca { display: flex; align-items: center; height: 100%; }
  .fita__logo { height: 75%; width: auto; max-width: clamp(8rem, 30vw, 20rem); object-fit: contain; }
  .fita__nome {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    letter-spacing: -0.01em;
    color: var(--sm-tinta-nome);
  }
  .fita__aviso {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.5rem, 0.85vw, 0.75rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sm-tinta-aviso);
  }

  /* A impressão passa pela fita da esquerda para a direita, como o rolo saindo da impressora.
     Só com JS (data-vivo): sem ele, a fita já nasce impressa. */
  @keyframes imprimir {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  [data-vivo] .fita__impressao[data-aguardando] { clip-path: inset(0 100% 0 0); }
  [data-vivo] .fita__impressao[data-imprimindo] { animation: imprimir var(--sm-dur-impressao) var(--sm-ease) both; }

  @media (prefers-reduced-motion: reduce) {
    [data-vivo] .fita__impressao[data-imprimindo] { animation: none; }
    .faixa, .fita, .opcao span { transition: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .fita[data-material="bopp"] { background: var(--sm-bopp-opaco); }
  }
  @media (prefers-contrast: more) {
    .fita[data-material="bopp"] { background: var(--sm-bopp-opaco); border-block: 2px solid var(--color-navy); }
  }
</style>

<script>
  import { whatsappLink, comLogoNaPrevia } from "../../lib/whatsapp";
  import { caixaDaTinta } from "../../lib/recorteLogo";

  // A busca da tinta roda numa cópia reduzida (rápida no celular); o corte sai da imagem original.
  const LADO_MAX_ANALISE = 1200;
  // Logo com menos que isso de altura (depois do recorte) amolece na fita de uma tela retina.
  const ALTURA_MIN_NITIDA = 60;
  const AVISO_BAIXA_RESOLUCAO =
    "A logo veio com pouca resolução e pode sair borrada na prévia. Para a arte final, mande o arquivo original no WhatsApp (de preferência PDF, AI, EPS ou CDR).";

  /** Corta a margem da logo. Sem como ler os pixels (SVG sem tamanho, canvas bloqueado), devolve a original. */
  async function recortarMargem(url: string): Promise<{ url: string; alturaPx: number }> {
    const img = new Image();
    img.src = url;
    try {
      await img.decode();
    } catch {
      return { url, alturaPx: Infinity };
    }
    const { naturalWidth: w0, naturalHeight: h0 } = img;
    if (!w0 || !h0) return { url, alturaPx: Infinity };

    const escala = Math.min(1, LADO_MAX_ANALISE / Math.max(w0, h0));
    const analise = document.createElement("canvas");
    analise.width = Math.max(1, Math.round(w0 * escala));
    analise.height = Math.max(1, Math.round(h0 * escala));
    const ctx = analise.getContext("2d", { willReadFrequently: true });
    if (!ctx) return { url, alturaPx: h0 };
    ctx.drawImage(img, 0, 0, analise.width, analise.height);

    let tinta;
    try {
      tinta = caixaDaTinta(ctx.getImageData(0, 0, analise.width, analise.height).data, analise.width, analise.height);
    } catch {
      return { url, alturaPx: h0 };
    }
    if (!tinta) return { url, alturaPx: h0 };

    // Volta à escala original, com 1 pixel de folga para não comer a borda suavizada.
    const sx = Math.max(0, Math.floor((tinta.x - 1) / escala));
    const sy = Math.max(0, Math.floor((tinta.y - 1) / escala));
    const sw = Math.min(w0 - sx, Math.ceil((tinta.w + 2) / escala));
    const sh = Math.min(h0 - sy, Math.ceil((tinta.h + 2) / escala));
    if (sw >= w0 && sh >= h0) return { url, alturaPx: h0 };

    const corte = document.createElement("canvas");
    corte.width = sw;
    corte.height = sh;
    corte.getContext("2d")!.drawImage(img, sx, sy, sw, sh, 0, 0, sw, sh);
    const blob = await new Promise<Blob | null>((ok) => corte.toBlob(ok, "image/png"));
    return blob ? { url: URL.createObjectURL(blob), alturaPx: sh } : { url, alturaPx: h0 };
  }

  interface Opcao {
    slug: string;
    rotulo: string;
    material: string;
    larguraMm: number;
    minimo: number;
    preco: string;
    condicao: string;
    contexto: string;
    origem: string;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>("[data-art='sua-marca']")) {
    const opcoes: Opcao[] = JSON.parse(raiz.dataset.opcoes ?? "[]");
    const maxBytes = Number(raiz.dataset.logoMaxMb ?? 10) * 1024 * 1024;
    const arquivo = raiz.querySelector<HTMLInputElement>("[data-arquivo]")!;
    const arquivoNome = raiz.querySelector<HTMLElement>("[data-arquivo-nome]")!;
    const ajuda = raiz.querySelector<HTMLElement>("[data-ajuda]")!;
    const ajudaPadrao = ajuda.textContent ?? "";
    const logos = raiz.querySelectorAll<HTMLImageElement>("[data-logo]");
    let logoUrl = "";
    const caixa = raiz.querySelector<HTMLElement>("[data-caixa]")!;
    const fita = raiz.querySelector<HTMLElement>("[data-fita]")!;
    const impressao = raiz.querySelector<HTMLElement>("[data-impressao]")!;
    const nomes = raiz.querySelectorAll<HTMLElement>("[data-nome]");
    const cta = raiz.querySelector<HTMLAnchorElement>("[data-cta] a")!;
    const escolhida = () =>
      opcoes.find((o) => o.slug === raiz.querySelector<HTMLInputElement>("[data-opcao]:checked")?.value) ?? opcoes[0];

    // Troca no meio de uma impressão não reinicia a passada: a fita já mudou e a passada segue de onde está.
    const imprimindo = () => impressao.getAnimations().some((a) => a.playState === "running");
    const imprimir = () => {
      if (imprimindo()) return;
      impressao.removeAttribute("data-imprimindo");
      void impressao.offsetWidth; // força o reflow para a mesma animação rodar de novo
      impressao.setAttribute("data-imprimindo", "");
    };

    const atualizar = () => {
      const o = escolhida();
      fita.dataset.material = o.material;
      caixa.style.setProperty("--sm-largura-mm", String(o.larguraMm));
      caixa.setAttribute("aria-label", `Prévia: ${o.rotulo} lacrando uma caixa de papelão, ${logoUrl ? "com a sua logo impressa" : "ainda sem logo"}`);
      raiz.querySelector("[data-minimo]")!.textContent = String(o.minimo);
      raiz.querySelector("[data-preco]")!.textContent = o.preco;
      raiz.querySelector("[data-condicao]")!.textContent = o.condicao;
      const link = whatsappLink(o.contexto, o.origem);
      cta.href = logoUrl ? comLogoNaPrevia(link) : link;
      // O layout acrescenta a fonte da visita no clique e marca o link; link novo precisa da frase de novo.
      delete cta.dataset.fonte;
    };

    const mostrarLogo = (url: string, nomeArquivo: string, aviso: string) => {
      if (logoUrl) URL.revokeObjectURL(logoUrl);
      logoUrl = url;
      logos.forEach((img) => {
        img.src = url;
        img.hidden = false;
      });
      nomes.forEach((n) => (n.hidden = true));
      arquivoNome.textContent = nomeArquivo;
      arquivo.closest(".anexo")!.setAttribute("data-com-logo", "");
      ajuda.textContent = aviso;
      atualizar();
      imprimir();
    };

    // Duas escolhas seguidas: só a última chega à fita.
    let escolhaAtual = 0;
    arquivo.addEventListener("change", async () => {
      const f = arquivo.files?.[0];
      if (!f) return;
      if (!f.type.startsWith("image/")) {
        ajuda.textContent = "Esse arquivo não é uma imagem. Envie a logo em PNG, JPG, WebP ou SVG.";
        return;
      }
      if (f.size > maxBytes) {
        ajuda.textContent = "Arquivo grande demais para a prévia. Envie uma versão menor da logo.";
        return;
      }
      const minhaEscolha = ++escolhaAtual;
      const original = URL.createObjectURL(f);
      const recortada = await recortarMargem(original);
      if (recortada.url !== original) URL.revokeObjectURL(original);
      if (minhaEscolha !== escolhaAtual) return URL.revokeObjectURL(recortada.url);
      mostrarLogo(recortada.url, f.name, recortada.alturaPx < ALTURA_MIN_NITIDA ? AVISO_BAIXA_RESOLUCAO : ajudaPadrao);
    });
    raiz.querySelectorAll("[data-opcao]").forEach((r) =>
      r.addEventListener("change", () => {
        atualizar();
        imprimir();
      }),
    );

    raiz.setAttribute("data-vivo", "");
    // Entrada: a primeira impressão acontece quando a caixa aparece. Com movimento reduzido, nasce impressa.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      impressao.setAttribute("data-aguardando", "");
      new IntersectionObserver(
        (entradas, observador) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          impressao.removeAttribute("data-aguardando");
          imprimir();
          observador.disconnect();
        },
        { threshold: 0.5 },
      ).observe(caixa);
    }
  }
</script>
