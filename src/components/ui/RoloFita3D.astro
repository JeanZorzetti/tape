---
// O momento da home: o rolo TapePro desenrolando a fita com a marca impressa.
// O pôster é um quadro da própria cena (scripts/rolo3d) e é o que todo mundo vê
// primeiro; a cena 3D só assume na primeira interação (rolar, tocar, mover), e nunca com movimento reduzido,
// economia de dados ou sem WebGL. Pôster e cena têm o mesmo enquadramento quadrado,
// então a troca entre os dois não aparece.
import { Image } from "astro:assets";
import poster from "../../assets/marca/rolo-3d-repouso.png";

interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---

<div class:list={["rolo-3d pointer-events-none relative aspect-square", cls]} data-rolo3d>
  <Image
    src={poster}
    alt="Rolo de fita laranja TapePro desenrolando, com a marca impressa ao longo da fita"
    widths={[480, 800, 1200]}
    sizes="(min-width: 1024px) min(50vw, 52rem), 86vw"
    loading="eager"
    fetchpriority="high"
    class="rolo-3d__quadro"
  />
  <canvas class="rolo-3d__quadro rolo-3d__cena" aria-hidden="true"></canvas>
</div>

<!-- Posição e tamanho da caixa ficam nas classes do Tailwind: estilo com escopo fica fora
     das camadas e venceria o `lg:absolute` de quem usa o componente. -->
<style>
  .rolo-3d__quadro {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rolo-3d__cena {
    opacity: 0;
    transition: opacity 250ms cubic-bezier(0, 0, 0.2, 1);
  }
  .rolo-3d[data-ao-vivo] .rolo-3d__cena {
    opacity: 1;
  }
  /* O pôster só some depois que a cena cobriu: quadros iguais, troca invisível. */
  .rolo-3d[data-ao-vivo] img {
    opacity: 0;
    transition: opacity 0s linear 250ms;
  }
</style>

<script>
  import { COMPRIMENTO_REPOUSO, CURSO_DA_ROLAGEM, PUXAO_DE_ENTRADA } from "../../lib/rolo3d/medidas";

  // Declarado em global.css (carimbo de art-direction): paisagem/expressivo.
  const DURACAO_DO_PUXAO_S = 1.4;
  const ESPERA_ANTES_DO_PUXAO_S = 0.25;
  const SUAVIZACAO_DA_ROLAGEM_S = 0.8;
  const ESPERA_MAXIMA_OCIOSA_MS = 2000;

  type ConexaoComEconomia = { connection?: { saveData?: boolean } };

  function suportaWebGL2(): boolean {
    try {
      return Boolean(document.createElement("canvas").getContext("webgl2"));
    } catch {
      return false;
    }
  }

  function podeAnimar(): boolean {
    const economizaDados = (navigator as Navigator & ConexaoComEconomia).connection?.saveData === true;
    return !matchMedia("(prefers-reduced-motion: reduce)").matches && !economizaDados && suportaWebGL2();
  }

  // Se o 3D falhar, o pôster continua no lugar: nada a avisar ao visitante.
  const ligarCena = (caixa: HTMLElement) => montarCena(caixa).catch(() => delete caixa.dataset.aoVivo);

  async function montarCena(caixa: HTMLElement) {
    const canvas = caixa.querySelector("canvas")!;
    const [{ criarCenaDoRolo, carregarFontesDaImpressao }, { gsap }, { ScrollTrigger }] = await Promise.all([
      import("../../lib/rolo3d/cena"),
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ]);
    await carregarFontesDaImpressao();
    gsap.registerPlugin(ScrollTrigger);

    const cena = criarCenaDoRolo(canvas);
    const estado = { puxao: 0, rolagem: 0 };
    let quadroPedido = 0;
    const desenhar = () => {
      quadroPedido = 0;
      cena.definirComprimento(COMPRIMENTO_REPOUSO + estado.puxao + estado.rolagem);
      cena.renderizar();
    };
    const pedirQuadro = () => {
      quadroPedido ||= requestAnimationFrame(desenhar);
    };
    const medir = () => {
      const { width, height } = caixa.getBoundingClientRect();
      cena.redimensionar(width, height);
      desenhar();
    };
    new ResizeObserver(medir).observe(caixa);
    medir();

    caixa.dataset.aoVivo = "";
    canvas.addEventListener("webglcontextlost", () => delete caixa.dataset.aoVivo);

    gsap.to(estado, {
      puxao: PUXAO_DE_ENTRADA,
      duration: DURACAO_DO_PUXAO_S,
      delay: ESPERA_ANTES_DO_PUXAO_S,
      ease: "power3.out",
      onUpdate: pedirQuadro,
    });
    gsap.to(estado, {
      rolagem: CURSO_DA_ROLAGEM,
      ease: "none",
      onUpdate: pedirQuadro,
      scrollTrigger: {
        trigger: caixa.closest("section") ?? caixa,
        start: "top top",
        end: "bottom top",
        scrub: SUAVIZACAO_DA_ROLAGEM_S,
      },
    });
  }

  // O núcleo do three + ScrollTrigger somam ~3 s de thread principal em celular médio
  // (TBT 5 s no PageSpeed). Quem não interage fica com o pôster, que é o mesmo quadro;
  // quem rola ou toca ganha a cena. Interação real é o sinal de que alguém está olhando.
  const EVENTOS_DE_INTERACAO = ["scroll", "pointerdown", "pointermove", "touchstart", "keydown", "wheel"] as const;

  const caixa = document.querySelector<HTMLElement>("[data-rolo3d]");
  if (caixa && podeAnimar()) {
    const aoInteragir = () => {
      EVENTOS_DE_INTERACAO.forEach((tipo) => removeEventListener(tipo, aoInteragir));
      "requestIdleCallback" in window
        ? requestIdleCallback(() => ligarCena(caixa), { timeout: ESPERA_MAXIMA_OCIOSA_MS })
        : setTimeout(() => ligarCena(caixa), 0);
    };
    EVENTOS_DE_INTERACAO.forEach((tipo) => addEventListener(tipo, aoInteragir, { passive: true }));
  }
</script>
