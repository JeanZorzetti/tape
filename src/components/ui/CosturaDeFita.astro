---
// A fita que sai do rolo do hero atravessa a home costurando as emendas: em cada emenda
// entre duas seções, um pedaço da mesma fita impressa é colado de uma borda da tela à
// outra enquanto a pessoa rola, com a ponta serrilhada erguida, sendo puxada. Uma emenda
// sai pela direita e a seguinte entra por ela (zigue-zague), até a FitaFinal do CTA.
// Vai entre duas seções, com altura zero: a tira fica metade em cada uma, dentro do
// padding (py-20). Sem JS ou com movimento reduzido ela já está colada: a página lacrada.
import ImpressaoDaFita from "./ImpressaoDaFita.astro";
import { pontaSerrilhada } from "../../lib/serrilha";
import "../../styles/fita.css";

interface Props {
  /** Para onde a fita é puxada nesta emenda. */
  sentido: "direita" | "esquerda";
}
const { sentido } = Astro.props;
---

<div class="costura" data-costura data-sentido={sentido} aria-hidden="true">
  <div class="costura__tira">
    <div class="fita-faixa costura__faixa" data-revela><ImpressaoDaFita /></div>
    <div class="fita-sombra" data-sombra></div>
    <div class="fita-ponta" data-ponta style={`clip-path: ${pontaSerrilhada(sentido)}`}>
      <div class="fita-faixa">
        <div class="fita-ponta__conteudo" data-conteudo><ImpressaoDaFita /></div>
      </div>
      <div class="fita-ponta__luz" data-luz></div>
    </div>
  </div>
</div>

<style>
  .costura {
    position: relative;
    z-index: 20;
    height: 0;
    overflow-x: clip;
    pointer-events: none;
  }
  .costura__tira {
    --espessura: clamp(2.5rem, 2rem + 1.5vw, 3.5rem);
    /* Folga do padding das seções (py-20) dos dois lados da emenda, menos meia espessura
       e um respiro: é o quanto a tira pode descer até a borda da tela sem tocar no conteúdo. */
    --queda: calc(5rem - var(--espessura) / 2 - 0.75rem);
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(106vw + 2 * var(--espessura));
    height: var(--espessura);
    translate: -50% -50%;
    rotate: calc(var(--sinal) * 2.5deg);
    rotate: calc(var(--sinal) * min(atan2(var(--queda), 50vw), 8deg));
  }
  [data-sentido="direita"] .costura__tira {
    --sinal: 1;
  }
  [data-sentido="esquerda"] .costura__tira {
    --sinal: -1;
  }
  .costura__faixa {
    position: absolute;
    inset: 0;
  }
  /* A dobradiça da ponta fica do lado de onde a fita vem. */
  [data-sentido="direita"] .fita-ponta {
    transform-origin: 0 50%;
  }
  [data-sentido="esquerda"] .fita-ponta {
    transform-origin: 100% 50%;
  }
  [data-sentido="esquerda"] .fita-ponta__luz {
    --lado-da-luz: 270deg;
  }
</style>

<script>
  import "../../lib/fita-costurada";
</script>
