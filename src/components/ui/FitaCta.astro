---
// O CTA final da home: um pedaço de fita com a ponta serrilhada pela lâmina, em que a fita
// 3D que desceu a página inteira termina. Com a cena ligada, a fita entra por baixo do lado
// direito (por isso ele fica reto); sem ela, a etiqueta é um pedaço de fita solto, com as
// duas pontas cortadas.
import { whatsappLink } from "../../lib/whatsapp";

interface Props {
  label?: string;
  paginaOrigem?: string;
  class?: string;
}
const { label = "Falar no WhatsApp", paginaOrigem, class: cls = "" } = Astro.props;
const href = whatsappLink(undefined, paginaOrigem);

const DENTES = 4;
const DENTE = "7px";
const passo = (i: number) => (i / (DENTES * 2)) * 100;
const pontaEsquerda = Array.from({ length: DENTES * 2 + 1 }, (_, i) => `${i % 2 ? "0" : DENTE} ${100 - passo(i)}%`);
const pontaDireita = Array.from({ length: DENTES * 2 + 1 }, (_, i) => `${i % 2 ? "100%" : `calc(100% - ${DENTE})`} ${passo(i)}%`);
const DUAS_PONTAS = `polygon(${[...pontaDireita, ...pontaEsquerda].join(", ")})`;
const SO_A_ESQUERDA = `polygon(100% 100%, ${pontaEsquerda.join(", ")}, 100% 0)`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  data-fita-fim
  class:list={["fita-cta", cls]}
  style={`--duas-pontas: ${DUAS_PONTAS}; --so-esquerda: ${SO_A_ESQUERDA}`}
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.24.68-1.42 1.32-1.96 1.36-.5.04-.98.22-3.3-.69-2.78-1.1-4.55-3.94-4.69-4.13-.14-.19-1.13-1.5-1.13-2.86s.71-2.03.97-2.31c.24-.28.53-.35.71-.35.18 0 .35 0 .5.01.16.01.38-.06.59.45.24.55.81 1.92.88 2.06.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.37-.42.49-.14.14-.28.29-.12.57.16.28.72 1.18 1.54 1.91 1.06.94 1.95 1.23 2.23 1.37.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.18-.28.37-.23.61-.14.24.09 1.55.73 1.81.87.28.14.46.21.53.32.07.12.07.68-.17 1.36Z"
    ></path>
  </svg>
  <span>{label}</span>
  <span aria-hidden="true" class="fita-cta__seta">→</span>
</a>

<style>
  .fita-cta {
    --altura: 3.25rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--altura);
    padding: 0 2.25rem 0 2rem;
    background: var(--color-orange);
    color: var(--color-navy);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    clip-path: var(--duas-pontas);
    transition: background-color 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  @media (min-width: 40rem) {
    .fita-cta {
      --altura: 3.5rem;
      font-size: 0.9375rem;
    }
  }
  /* Pontilhado de borda: o mesmo da faixa TapeStrip e da impressão da fita 3D. */
  .fita-cta::before,
  .fita-cta::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    border-top: 2px dashed currentColor;
    opacity: 0.4;
  }
  .fita-cta::before { top: 6px; }
  .fita-cta::after { bottom: 6px; }
  .fita-cta:hover { background: var(--color-orange-400); }
  .fita-cta__seta { transition: transform 150ms cubic-bezier(0.2, 0, 0, 1); }
  .fita-cta:hover .fita-cta__seta { transform: translateX(4px); }
  .fita-cta:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
    clip-path: none;
  }
  :global([data-fita-ao-vivo]) .fita-cta {
    clip-path: var(--so-esquerda);
    padding-right: 3rem;
  }
  :global([data-fita-ao-vivo]) .fita-cta::before,
  :global([data-fita-ao-vivo]) .fita-cta::after { right: 0; }
  @media (prefers-reduced-motion: reduce) {
    .fita-cta, .fita-cta__seta { transition: none; }
  }
</style>
