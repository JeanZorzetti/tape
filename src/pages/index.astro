---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppCta from "../components/quote/WhatsAppCta.astro";
import TapeStrip from "../components/ui/TapeStrip.astro";
import RoloFita3D from "../components/ui/RoloFita3D.astro";
import CosturaDeFita from "../components/ui/CosturaDeFita.astro";
import FitaFinal from "../components/ui/FitaFinal.astro";
import { PEDIDO_MINIMO_ROLOS, EMPRESAS_ATENDIDAS } from "../lib/constants";
import { PRODUTOS } from "../lib/produtos";
import { postsPublicados } from "../lib/conteudo";

import natures from "../assets/portfolio/natures.png";
import halyee from "../assets/portfolio/halyee.png";
import lyon from "../assets/portfolio/lyon.png";
import finaart from "../assets/portfolio/finaart.png";
import comando from "../assets/portfolio/comando.png";
import yanmei from "../assets/portfolio/yanmei.png";
import quemed from "../assets/portfolio/quemed.png";

const ORIGEM = "Home";

const brl = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

const diferenciais = [
  { num: `${PEDIDO_MINIMO_ROLOS}`, unidade: "rolos", texto: "Pedido mínimo da fita personalizada. A gomada sai a partir de 15." },
  { num: `+${(EMPRESAS_ATENDIDAS).toLocaleString("pt-BR")}`, unidade: "empresas", texto: "Já estampam suas caixas com a TapePro." },
  { num: "2", unidade: "cores", texto: "De impressão inclusas na sua arte." },
  { num: "100%", unidade: "nacional", texto: "Atendimento e entrega para todo o Brasil." },
];

// Lyon abre a vitrine ao lado do título: é a marca que mais se lê no recorte.
const portfolio = [
  { img: lyon, nome: "Lyon Peças", tipo: "Transparente" },
  { img: comando, nome: "Comando Auto Peças", tipo: "Transparente" },
  { img: finaart, nome: "Finaart", tipo: "Transparente" },
  { img: halyee, nome: "Halyee", tipo: "Transparente" },
  { img: natures, nome: "Nature's Prime", tipo: "Transparente" },
  { img: yanmei, nome: "Yanmei", tipo: "Gomada kraft" },
  { img: quemed, nome: "Quemed", tipo: "Gomada kraft" },
];

const selos = ["Cuidado, Frágil", "Volume conferido", "Selo de garantia de violação"];

// Cada aviso é um pedaço de fita com as pontas serrilhadas pela lâmina do aplicador.
const DENTES = 4;
const DENTE = "6px";
const passo = (i: number) => (i / (DENTES * 2)) * 100;
const pontaDireita = Array.from({ length: DENTES * 2 + 1 }, (_, i) => `${i % 2 ? "100%" : `calc(100% - ${DENTE})`} ${passo(i)}%`);
const pontaEsquerda = Array.from({ length: DENTES * 2 + 1 }, (_, i) => `${i % 2 ? "0" : DENTE} ${100 - passo(i)}%`);
const SERRILHA = `polygon(${[...pontaDireita, ...pontaEsquerda].join(", ")})`;
const GIROS = ["-1.5deg", "1deg", "-0.5deg"];

const segmentos = (await getCollection("segmentos")).sort((a, b) => a.data.ordem - b.data.ordem);
const posts = (await postsPublicados()).slice(0, 3);
---

<BaseLayout
  title="Fitas Adesivas Personalizadas: Preço por Rolo | TapePro"
  description="Fitas adesivas personalizadas para empresas: transparente e kraft com a sua marca impressa. A partir de 20 rolos, até 2 cores, atendimento nacional."
  cabecalho="ponta"
>
  <!-- HERO: o rolo desenrolando é o único momento de movimento da página (CLAUDE.md, Motion).
       Abaixo de lg o rolo vem antes do texto e a fita some num degradê; em lg ele ocupa o
       canto e a fita sai pela borda de baixo, emendando na faixa TapeStrip. -->
  <section class="grao-noite relative isolate overflow-hidden bg-navy text-white">
    <!-- Abaixo de sm o rolo encolhe para o botão do WhatsApp caber inteiro na primeira tela (360×740). -->
    <RoloFita3D
      class="mask-fita ml-auto -mb-14 w-[62vw] max-w-lg sm:w-[86vw] lg:absolute lg:bottom-0 lg:right-0 lg:-z-10 lg:mb-0 lg:w-[min(50vw,52rem)] lg:max-w-none"
    />

    <div class="mx-auto flex max-w-6xl flex-col justify-end px-4 pb-16 lg:min-h-[86vh] lg:pb-24 lg:pt-24">
      <div class="max-w-xl lg:max-w-[34rem] xl:max-w-[36rem]">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-orange">Fitas adesivas personalizadas · B2B</p>
        <h1 class="mt-5 font-display text-[clamp(2.75rem,6.4vw,5rem)] font-extrabold leading-[0.92] tracking-[-0.03em] text-white">
          Sua marca sela cada caixa que sai.
        </h1>
        <p class="mt-6 max-w-xl font-body text-lg leading-relaxed text-white/85">
          A TapePro imprime a identidade da sua empresa em fita transparente ou kraft: lacre, proteja e divulgue a cada
          envio. A partir de {PEDIDO_MINIMO_ROLOS} rolos, com até 2 cores.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <WhatsAppCta label="Pedir orçamento no WhatsApp" paginaOrigem={ORIGEM} />
          <a
            href="/produtos/fita-transparente-personalizada/#previa"
            class="inline-flex min-h-11 items-center font-body text-sm font-semibold text-white/90 underline-offset-4 hover:underline"
          >
            Ver sua logo na fita →
          </a>
        </div>
        <p class="mt-8 font-mono text-xs uppercase tracking-widest text-white/65">
          +{EMPRESAS_ATENDIDAS.toLocaleString("pt-BR")} empresas já estampam suas caixas com a gente
        </p>
      </div>
    </div>
    <TapeStrip tone="orange" class="relative z-10" />
  </section>

  <!-- PRODUTOS -->
  <section id="produtos" class="mx-auto max-w-6xl px-4 py-20 lg:py-28">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-orange-800">O que a gente faz</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Três fitas, uma missão: sua marca protegendo o pacote.</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        PRODUTOS.map((p) => (
          <article class="flex flex-col rounded-2xl border border-kraft/50 bg-white p-7 transition hover:border-orange">
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-steel">
              {p.specs[0].valor} × {p.specs[1].valor} · {p.eyebrow}
            </p>
            <h3 class="mt-3 text-xl text-navy">
              <a href={`/produtos/${p.slug}/`} class="hover:text-orange-800">
                {p.nome}
              </a>
            </h3>
            <p class="mt-3 flex-1 font-body text-sm leading-relaxed text-ink/75">{p.resumo}</p>
            {/* O preço do pedido mínimo vem primeiro: é o que paga quem chega pelo "a partir de 20 rolos" do hero. */}
            {p.precoNoMinimo ? (
              <p class="mt-4 font-body text-sm text-steel">
                <strong class="font-display text-lg tabular-nums text-navy">{brl(p.precoNoMinimo.porRolo)}</strong> por rolo
                com {p.precoNoMinimo.rolos} rolos
                <span class="block text-xs">
                  cai para <span class="tabular-nums">{brl(p.preco.aPartirDe)}</span> {p.preco.condicao}
                </span>
                {p.personalizavel && <span class="block text-xs">clichê da arte à parte, pago uma vez</span>}
              </p>
            ) : (
              <p class="mt-4 font-body text-sm text-steel">
                <strong class="font-display text-lg tabular-nums text-navy">{brl(p.preco.aPartirDe)}</strong> por rolo
              </p>
            )}
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <WhatsAppCta label="Pedir orçamento" contexto={p.contexto} paginaOrigem={ORIGEM} variant="light" compact />
              <a
                href={`/produtos/${p.slug}/`}
                class="inline-flex min-h-11 items-center font-body text-sm font-semibold text-navy underline-offset-4 hover:underline"
              >
                Ver ficha →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- A fita do rolo do hero costura cada emenda daqui até o CTA, em zigue-zague: entra
       pela borda de onde a anterior saiu. A última ponta é o botão (FitaFinal). -->
  <CosturaDeFita sentido="direita" />

  <!-- DIFERENCIAIS -->
  <section id="diferenciais" class="grao-kraft bg-kraft-100">
    <div class="mx-auto max-w-6xl px-4 py-20 lg:py-28">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          diferenciais.map((d) => (
            <div class="border-t-2 border-navy/15 pt-5">
              <p class="font-display text-4xl font-extrabold text-navy md:text-5xl">
                {d.num} <span class="font-mono text-sm font-medium uppercase tracking-widest text-orange-800">{d.unidade}</span>
              </p>
              <p class="mt-3 font-body text-sm leading-relaxed text-ink/70">{d.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CosturaDeFita sentido="esquerda" />

  <!-- PORTFÓLIO: a vitrine. As fitas reais dos clientes são o assunto da página. O título
       ocupa a primeira casa da grade e as 7 fitas fecham 4 linhas de 2, gomadas juntas no fim.
       ponytail: 2 colunas, não destaque em largura total: o recorte vem de foto de Instagram
       ampliada e amolece acima de ~550px. Foto nova da TapePro libera o destaque. -->
  <section id="portfolio" class="grao-noite bg-navy-800 text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-x-12 gap-y-14 md:grid-cols-2 md:gap-y-20">
        <header class="self-end">
          <p class="font-mono text-xs uppercase tracking-[0.28em] text-orange">Portfólio</p>
          <h2 class="mt-3 text-4xl lg:text-5xl">Marcas que já viajam em cada encomenda.</h2>
          <p class="mt-5 max-w-md font-body leading-relaxed text-white/75">
            Trabalhos reais impressos pela TapePro: do jeans ao autopeças, da farmácia ao alimentício.
            <a href="/sobre/" class="font-semibold text-white underline decoration-orange underline-offset-4 hover:text-orange"
              >Lista de clientes e como trabalhamos</a
            >.
          </p>
        </header>
        {
          portfolio.map((c) => (
            <figure>
              <div class="aspect-[3/1]">
                <Image
                  src={c.img}
                  alt={`Fita personalizada TapePro para ${c.nome}`}
                  loading="lazy"
                  widths={[480, 720, 1100]}
                  sizes="(min-width: 1152px) 536px, (min-width: 768px) 46vw, 92vw"
                  class="h-full w-full object-contain object-left-bottom drop-shadow-fita"
                />
              </div>
              <figcaption class="mt-5 flex items-baseline justify-between gap-4 border-t border-white/15 pt-3">
                <span class="font-display text-lg font-bold">{c.nome}</span>
                <span class="font-mono text-[0.65rem] uppercase tracking-widest text-white/65">{c.tipo}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-20 grid gap-10 border-t border-white/15 pt-14 md:grid-cols-12 md:items-center">
        <div class="md:col-span-7">
          <p class="font-mono text-xs uppercase tracking-[0.28em] text-orange">Fita que protege e comunica</p>
          <h2 class="mt-3 text-3xl md:text-4xl">Mais que marca: segurança impressa.</h2>
          <p class="mt-5 max-w-lg font-body leading-relaxed text-white/80">
            Além do seu logo, imprimimos avisos que reduzem extravio e contestação, e mostram ao cliente que o pacote chegou
            intacto.
          </p>
        </div>
        <ul class="flex flex-wrap gap-4 md:col-span-5 md:justify-end">
          {
            selos.map((s, i) => (
              <li
                class="bg-orange px-6 py-2.5 font-mono text-xs font-medium uppercase tracking-[0.2em] text-navy"
                style={`clip-path: ${SERRILHA}; rotate: ${GIROS[i % GIROS.length]}`}
              >
                {s}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CosturaDeFita sentido="direita" />

  <!-- SEGMENTOS -->
  <section id="segmentos" class="mx-auto max-w-6xl px-4 py-20 lg:py-28">
    <p class="font-mono text-xs uppercase tracking-[0.28em] text-orange-800">Aplicações</p>
    <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">A mesma fita resolve problemas diferentes.</h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-kraft/50 bg-kraft/40 sm:grid-cols-2 lg:grid-cols-4">
      {
        segmentos.map((s) => (
          <a href={`/segmentos/${s.id}/`} class="group flex flex-col bg-paper p-6 transition hover:bg-white">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-steel">{s.data.eyebrow}</p>
            <h3 class="mt-3 font-display text-lg font-bold text-navy group-hover:text-orange-800">{s.data.titulo}</h3>
            <p class="mt-2 flex-1 font-body text-sm leading-relaxed text-ink/70">{s.data.chamada}</p>
            <span class="mt-5 font-body text-sm font-semibold text-navy group-hover:text-orange-800" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <CosturaDeFita sentido="esquerda" />

  <!-- BLOG -->
  <section class="grao-kraft bg-kraft-100">
    <div class="mx-auto max-w-6xl px-4 py-20 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.28em] text-orange-800">Conteúdo técnico</p>
          <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">O que ninguém explica sobre fita.</h2>
        </div>
        <a href="/blog/" class="inline-flex min-h-11 items-center font-body text-sm font-semibold text-navy underline-offset-4 hover:underline">
          Ver todos os artigos →
        </a>
      </div>

      <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-3">
        {
          posts.map((p) => (
            <article>
              <a href={`/blog/${p.id}/`} class="group block">
                <Image
                  src={p.data.imagem}
                  alt={p.data.imagemAlt}
                  widths={[400, 800]}
                  sizes="(min-width: 640px) 340px, 100vw"
                  loading="lazy"
                  class="aspect-[3/2] w-full rounded-xl object-cover"
                />
                <h3 class="mt-4 font-display text-base font-bold leading-snug text-navy group-hover:text-orange-800">
                  {p.data.titulo}
                </h3>
                <p class="mt-2 font-body text-sm leading-relaxed text-ink/70">{p.data.descricao}</p>
              </a>
            </article>
          ))
        }
      </div>

      <p class="mt-12 font-body text-ink/70">
        Dúvidas de pedido, prazo, clichê e cores estão em
        <a href="/perguntas-frequentes/" class="font-semibold text-navy underline decoration-orange underline-offset-4 hover:text-orange-800">
          perguntas frequentes</a>.
      </p>
    </div>
  </section>

  <CosturaDeFita sentido="direita" />

  <!-- CTA FINAL: a fita que costurou a home entra pela direita e a ponta para aqui: ela é o
       botão do WhatsApp. Fundo navy, como o hero: o laranja da fita some sobre laranja. -->
  <section id="contato" class="grao-noite overflow-x-clip bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-24 md:py-32">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-orange">Orçamento</p>
      <h2 class="mt-4 max-w-2xl text-4xl text-white md:text-6xl">Peça seu orçamento hoje.</h2>
      <p class="mt-5 max-w-lg font-body text-lg leading-relaxed text-white/85">
        Resposta rápida no WhatsApp · pedido mínimo de {PEDIDO_MINIMO_ROLOS} rolos · atendimento nacional.
      </p>
      <div class="mt-12">
        <FitaFinal label="Falar no WhatsApp" paginaOrigem={`${ORIGEM} · CTA final`} />
      </div>
      <a
        href="/orcamento/"
        class="mt-8 inline-flex min-h-11 items-center font-body text-sm font-semibold text-white/90 underline underline-offset-4 hover:no-underline"
      >
        ou envie o pedido pelo formulário →
      </a>
    </div>
  </section>
</BaseLayout>
